    {
      "idRef": {
        "id": "b0dc4919c9732b892431c696"
      },
      "index": 10,
      "text": "My intent is to use superior fighter cover to give me the choice of drop zones. From there, I plan to split the First Battalion of McCrimmon's Light Cavalry away from [[DM.BaseDescriptionDefs[LoreNWHMarions], Marion's Highlanders]], push them into the mountains, where they will have nowhere to retreat to and then destroy them. After that, I can deal with the Highlanders at my leisure.",
      "branches": [
        {
