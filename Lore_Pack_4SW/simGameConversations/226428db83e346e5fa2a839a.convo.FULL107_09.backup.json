    {
      "idRef": {
        "id": "36b9717240e00584d215a043"
      },
      "index": 1,
      "text": "You and your {COMPANY.CompanyName} have impressed again, Commander {COMMANDER.LastName}. Count Jenkins will be more than pleased to know his son is safe and you have made my life easier, as well as indebting the Third Guards to you.",
      "branches": [
        {
          "responseText": "<color=#85DBF6FF>HONEST</color> You may want to have a word to Lieutenant Jenkins, Marshal, the lad going to get himself killed if he keeps behaving like he did.",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 2,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "51288c0592eb6325b089fe81"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        },
        {
          "responseText": "<color=#85DBF6FF>APPRECIATIVE</color> I am simply happy that Lieutenant Jenkins is safe, Marshal Hobaugh.",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 3,
          "hideIfUnavailable": true,
