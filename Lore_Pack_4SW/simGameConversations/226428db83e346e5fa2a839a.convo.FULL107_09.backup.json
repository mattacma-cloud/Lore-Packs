        "id": "1a1df0889c0da35d3dc8b594"
      },
      "index": 6,
      "text": "Welcome to Ningpo, Commander {COMMANDER.LastName}, are you ready for some quick action?",
      "branches": [
        {
          "responseText": "<color=#85DBF6FF>BRAVADO</color> Fighting like the Third Guards has worked so far, Marshal. Might as well keep at it.",
          "conditions": null,
          "actions": null,
          "nextNodeIndex": 7,
          "hideIfUnavailable": true,
          "onlyOnce": false,
          "idRef": {
            "id": "b899c078d3f359645f948118"
          },
          "inputBypass": false,
          "auxiliaryLink": false,
          "comment": ""
        },
        {
          "responseText": "<color=#85DBF6FF>CAUTION</color> A new world is a new challenge, Marshal, I'll keep calm until I know the lay of the land",
