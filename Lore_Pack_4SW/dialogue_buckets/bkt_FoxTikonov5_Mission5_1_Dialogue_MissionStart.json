{
  "identifier": "bkt_FoxTikonov5_Mission5_1_Dialogue_MissionStart",
  "contents": [
    {
      "words": "All right both of you. The Maskirovka is going to come out of the woodwork for us on this one. We only need to break a company to create a hole for the AFFS infantry to get through and nab those Exterminators for us, but word is that an entire Battalion has been sent our way.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "A battalion? I know we're good, but that's getting ridiculous.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Karl_Ryder",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "We best keep focused on the prize then.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Commander",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "There's more than one prize, Commander. DMI is reporting that the Capellans got more out of the Tikonov cache than we initially realised. There may be a company of SLDF 'Mechs out there waiting for us.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "That's some serious salvage, Captain. I think my team will want to go for it.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Commander",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Oh you can most certainly believe that.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_YangDefault",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    }
  ]
}
