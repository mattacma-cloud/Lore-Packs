                                            "a":  1
                                        },
                         "selectedCastDefId":  "castDef_Davion_Wilson_Mandella",
                         "emote":  "Default",
                         "audioName":  "NONE",
                         "cameraFocusGuid":  "",
                         "cameraDistance":  "Far",
                         "cameraHeight":  "Default",
                         "revealRadius":  -1
                     },
                     {
                         "words":  "Any more word on the opposition?",
