                         "selectedCastDefId":  "castDef_Davion_Wilson_Mandella",
                         "emote":  "Default",
                         "audioName":  "NONE",
                         "cameraFocusGuid":  "",
                         "cameraDistance":  "Far",
                         "cameraHeight":  "Default",
                         "revealRadius":  -1
                     },
                     {
                         "words":  "What about Captain Holzmann? Where is the Captain?",
                         "wordsColor":  {
                                            "r":  1,
                                            "g":  1,
                                            "b":  1,
                                            "a":  1
                                        },
                         "selectedCastDefId":  "castDef_DariusDefault",
                         "emote":  "Default",
                         "audioName":  "NONE",
                         "cameraFocusGuid":  "",
                         "cameraDistance":  "Far",
                         "cameraHeight":  "Default",
                         "revealRadius":  -1
                     },
                     {
                         "words":  "Captain Holzmann has been separated from his unit during the approach, which means you will be starting the assault on your own with the rest of his lance. We can\u0027t wait, as the main Beta Combat Command attack is about to jump off, so I need those guns taken.",
                         "wordsColor":  {
                                            "r":  1,
                                            "g":  1,
