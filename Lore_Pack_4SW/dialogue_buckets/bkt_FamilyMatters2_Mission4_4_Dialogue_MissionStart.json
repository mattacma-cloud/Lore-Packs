    "contents": [
        {
            "words": "Commander  -  you are facing a battalion from my daughter's regiment: Trimaldi's Secutors. Alpha and Beta lances have been seen ahead of you, and we expect Gamma Lance of the First company will reinforce. Break the company... but if Vanessa is on this field, I do not want to see my daughter harmed.",
            "wordsColor": {
                "r": 1,
                "g": 1,
                "b": 1,
                "a": 1
            },
            "selectedCastDefId": "castDef_Davion_Vernon_Fredricks",
            "emote": "Default",
            "audioName": "NONE",
            "cameraFocusGuid": "",
            "cameraDistance": "Far",
            "cameraHeight": "Default",
            "revealRadius": -1
        },
        {
            "words": "Father's pet mercs. Come take Trimaldi's colours if you dare  -  I will not bend the knee to the false Prince Davion. Or perhaps you might like to follow my path and join the Confederation? We can pay you well.",
            "wordsColor": {
                "r": 1,
                "g": 1,
                "b": 1,
                "a": 1
            },
            "selectedCastDefId": "castDef_Liao_Vanessa_Fredericks",
            "emote": "Default",
            "audioName": "NONE",
            "cameraFocusGuid": "",
            "cameraDistance": "Far",
            "cameraHeight": "Default",
            "revealRadius": -1
        },
        {
            "words": "Thank you, but we are well paid as it is.",
            "wordsColor": {
                "r": 1,
                "g": 1,
                "b": 1,
                "a": 1
            },
            "selectedCastDefId": "castDef_DariusDefault",
            "emote": "Default",
            "audioName": "NONE",
            "cameraFocusGuid": "",
            "cameraDistance": "Far",
            "cameraHeight": "Default",
            "revealRadius": -1
        },
        {
            "words": "Marshall, we'll try to not harm your daughter. Darius out.",
