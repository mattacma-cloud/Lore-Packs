{
  "identifier": "bkt_FoxTikonov3_Mission3_2_Dialogue_Target_Lance_01_Swap",
  "contents": [
    {
      "words": "Commander, I've got Abano on the line!",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Captain McKinnon. I seem to have both a problem and an opportunity. Agent Diaconu has come to see me as expendable and I find that dying for the Chancellor is well above my pay grade.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Liao_Akhmat_Abano",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Go on.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Captain, if you can get me out of here, I'll be more than happy to provide whatever information I can, so that you can return the favour to Ina and the Maskirovka for me.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Liao_Akhmat_Abano",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "What do you think, Commander?",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Can't hurt to try, can it, Commander?",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_DariusDefault",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "We're in this deep already, might as well go all in, especially if it cuts the chase short. Let's do it Captain.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Commander",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Excellent, we're on the same page...Abano, we're coming to get you. Try not to get killed in the meantime.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Davion_Ian_McKinnon",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    },
    {
      "words": "Captain McKinnon, I will do my absolute best to comply with your suggestion.",
      "wordsColor": {
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1
      },
      "selectedCastDefId": "castDef_Liao_Akhmat_Abano",
      "emote": "Default",
      "audioName": "NONE",
      "cameraFocusGuid": "",
      "cameraDistance": "Far",
      "cameraHeight": "Default",
      "revealRadius": -1
    }
  ]
}
